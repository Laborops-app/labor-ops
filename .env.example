# Copy to .env on the server (never commit .env). Generate secrets with:  openssl rand -hex 24
DOMAIN=demo.laborops.app
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too
JWT_SECRET=at-least-32-characters-long-random-string

# Demo data: creates a sample company and shows quick-login buttons on the sign-in page.
SEED_DEMO=true
DEMO_PASSWORD=LaborOps-Demo-1

# Public address of the app (used in email/SMS links). Defaults to https://$DOMAIN.
APP_URL=https://demo.laborops.app

# Email via Amazon SES SMTP (SES console -> SMTP settings -> Create SMTP credentials). Blank = log-only.
SES_SMTP_HOST=email-smtp.us-west-2.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASS=
EMAIL_FROM=LaborOps <no-reply@laborops.app>

# Text messages. SMS_PROVIDER is 'twilio' or 'sns'. Blank credentials = log-only.
SMS_PROVIDER=sns
# Amazon SNS (IAM user allowed sns:Publish and sns:ListPhoneNumbersOptedOut)
SNS_REGION=us-west-2
SNS_ACCESS_KEY_ID=
SNS_SECRET_ACCESS_KEY=
SNS_ORIGINATION_NUMBER=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Encrypts integration passwords saved on the Messaging page. Generate once: openssl rand -hex 32 . Do not change later,
# or saved settings become unreadable. If blank, JWT_SECRET is used instead.
SETTINGS_ENCRYPTION_KEY=

# Object storage (RustFS, runs in docker compose). Uploads and backups go to separate buckets.
# Turn it on with the profile below plus the two keys; without them files stay in Postgres and backups are off.
COMPOSE_PROFILES=storage
# Generate: openssl rand -hex 12 (access key) and openssl rand -hex 24 (secret key). Do not use "rustfsadmin".
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_CHAT=laborops-chat
S3_BUCKET_DOCUMENTS=laborops-documents
S3_BUCKET_BACKUPS=laborops-backups
# Optional: keep backups on another S3 server so they survive losing this one (e.g. RustFS on a second machine,
# AWS S3, Backblaze B2, Wasabi). Blank = the local RustFS.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Nightly database backup time (UTC hour) and how many to keep.
BACKUP_HOUR_UTC=9
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
# Emails of the admins who run the platform (see Storage & backups on the Integrations page).
PLATFORM_ADMINS=cadehardy@upstagecrews.com
