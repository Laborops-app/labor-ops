# Copy to .env on the server (never commit .env). Generate secrets with:  openssl rand -hex 24
DOMAIN=demo.laborops.app
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too
JWT_SECRET=at-least-32-characters-long-random-string

# Demo data: creates a sample company and shows quick-login buttons on the sign-in page.
SEED_DEMO=true
DEMO_PASSWORD=LaborOps-Demo-1

# Public address of the app (used in email/SMS links). Defaults to https://$DOMAIN.
APP_URL=https://demo.laborops.app

# Email via Amazon SES SMTP (SES console -> SMTP settings -> Create SMTP credentials). Blank = log-only.
SES_SMTP_HOST=email-smtp.us-west-2.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASS=
EMAIL_FROM=LaborOps <no-reply@laborops.app>

# Text messages through Zernio (zernio.com). Blank = log-only. Each company can also save its own key in the app
# (Messaging page), which is the recommended place: it is stored encrypted.
ZERNIO_API_KEY=
# The SMS-enabled number (E.164, e.g. +18015550100) or approved branded sender ID to send from.
ZERNIO_FROM=

# Encrypts integration passwords saved on the Messaging page. Generate once: openssl rand -hex 32 . Do not change later,
# or saved settings become unreadable. If blank, JWT_SECRET is used instead.
SETTINGS_ENCRYPTION_KEY=

# Object storage (RustFS) runs automatically and is managed on the Platform page; nothing to set here.
# Optional hand configuration (used only when nothing is saved on the Platform page):
# S3_ENDPOINT= S3_ACCESS_KEY= S3_SECRET_KEY= BACKUP_S3_ENDPOINT= BACKUP_S3_ACCESS_KEY= BACKUP_S3_SECRET_KEY=

# The platform console (manages every company) has its own address. Point this DNS name at the server too.
# Create the first platform admin with:  docker compose exec api node dist/platformCli.js invite you@example.com
PLATFORM_DOMAIN=sysadmin.laborops.app
