# Caddy terminates HTTPS (automatic Let's Encrypt certificates) and routes by host and path.
#
#   {$DOMAIN}            the app companies use:   /api/* -> API, everything else -> web
#   {$PLATFORM_DOMAIN}   the platform console:    /platform pages and /api/platform/* only
#
#   {$SITE_DOMAIN}        the public website (static files in infra/site); www. redirects to it
#   {$DEMO_DOMAIN}        the public demo, through the demo gate (starts it on demand)
#
# The console is only reachable on its own address, so its sign-in cookie never touches the company app.

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$DOMAIN} {
	import common

	# Old links to the console go to its own address; its API is not served here.
	@console path /platform /platform/*
	handle @console {
		redir https://{$PLATFORM_DOMAIN}{uri} 302
	}
	handle /api/platform/* {
		respond "Not found" 404
	}

	handle /api/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}
}

{$PLATFORM_DOMAIN} {
	import common
	header X-Robots-Tag "noindex, nofollow"

	handle /api/platform/* {
		reverse_proxy api:4000
	}
	handle /api/* {
		respond "Not found" 404
	}

	# Console pages and the files they load. Anything else (the company app's pages) is not served here.
	@console path /platform /platform/* /_next/* /brand/* /sidebar/* /manifest.webmanifest
	handle @console {
		reverse_proxy web:3000
	}

	handle {
		redir * /platform 302
	}
}

{$SITE_DOMAIN} {
	import common
	root * /srv/site
	try_files {path} {path}.html {path}/index.html
	file_server
	handle_errors {
		rewrite * /index.html
		file_server
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} 301
}

{$DEMO_DOMAIN} {
	import common
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy demo-gate:8080 {
		flush_interval -1
	}
}
